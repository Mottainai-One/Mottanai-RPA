LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_SSLMODE=require

# Operational database - destination
OPERATIONAL_DB_HOST=
OPERATIONAL_DB_PORT=
OPERATIONAL_DB_NAME=
OPERATIONAL_DB_USER=
OPERATIONAL_DB_PASSWORD=
