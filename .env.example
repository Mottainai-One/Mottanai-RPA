# Pipeline (ajuste após confirmar o schema de origem/destino)
SOURCE_SCHEMA=public
SOURCE_TABLE=
SOURCE_INCREMENTAL_COLUMN=updated_at
DESTINATION_SCHEMA=mottainai
MIGRATION_DRY_RUN=true
